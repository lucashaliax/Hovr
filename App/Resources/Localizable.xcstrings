    },
    "1 day": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1 dia"
          }
        }
      }
    },
    "A card left partly off the screen stays there. When off, it slides back onto the screen.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um card deixado parcialmente fora da tela fica lá. Desligado, ele volta para dentro da tela."
          }
        }
      }
    },
    "A light tap on the trackpad when a card docks or the capture mode changes.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque leve no trackpad quando um card encaixa ou o modo de captura muda."
          }
        }
      }
    },
    "A whole window": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma janela inteira"
          }
        }
      }
    },
