{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@ is available": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ está disponível"
          }
        }
      }
    },
    "%lld active": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ativos"
          }
        }
      }
    },
    "%lld characters": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld caracteres"
          }
        }
      }
    },
