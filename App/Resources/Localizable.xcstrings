          }
        }
      }
    },
    "Drag to move, drag an edge to resize, pinch or ⌘-scroll to zoom, ⌥-scroll for opacity, double-click for original size, Esc to close.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para mover, arraste uma borda para redimensionar, use pinça ou ⌘ + rolagem para zoom, ⌥ + rolagem para opacidade, clique duplo para o tamanho original, Esc para fechar."
          }
        }
      }
    },
    "Drag, or two fingers": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastar, ou dois dedos"
