        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastar"
          }
        }
      }
    },
    "Drag a card with two fingers on the trackpad and flick to throw it. Text that scrolls still scrolls.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um card com dois dedos no trackpad e dê um peteleco para arremessar. Texto que rola continua rolando."
          }
        }
      }
    },
