    "Cards can hang past the screen edge": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cards podem passar da borda da tela"
          }
        }
      }
    },
    "Cards move to the main display as they were: docked cards stay docked, open cards stay open.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cards vão para a tela principal como estavam: encaixados continuam encaixados, abertos continuam abertos."
          }
        }
      }
    },
    "Cards move to the middle of the main display, open.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cards vão para o centro da tela principal, abertos."
          }
        }
      }
    },
