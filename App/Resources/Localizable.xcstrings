      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturar texto"
          }
        }
      }
    },
    "Capture anything on screen and keep it floating above every window as a visual reference, or copy its text.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture qualquer coisa na tela e deixe flutuando acima de todas as janelas como referência visual, ou copie o texto."
          }
        }
      }
    },
    "Capture on every display at once. When off, only the display with the pointer.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura em todas as telas ao mesmo tempo. Desligado, só na tela com o cursor."
          }
        }
      }
    },
    "Capture the window under the pointer (when window click is on)": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturar a janela sob o cursor (com \"Clique em janela\" ligado)"
          }
        }
      }
    },
    "Captures are deleted after %lld days. Cards on screen are always kept.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas são apagadas depois de %lld dias. Os cards na tela sempre ficam."
          }
        }
      }
    },
    "Captures folder": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasta das capturas"
          }
        }
      }
    },
    "Captures in Recents are deleted after %lld days. Cards on screen are always kept.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas em Recentes são apagadas depois de %lld dias. Os cards na tela sempre ficam."
          }
        }
      }
    },
    "Captures stay in Recents until you delete them.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas ficam em Recentes até você apagá-las."
          }
        }
      }
    },
    "Captures stay until you delete them.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas ficam até você apagá-las."
          }
        }
